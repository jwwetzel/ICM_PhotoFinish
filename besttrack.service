[Unit]
Description=BestTrack Photo Finish Controller
Documentation=file:///home/pi/bestTrack.py
# Wait until the desktop has had time to come up
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=pi
Group=pi

# Display access (X11 on standard Raspbian desktop)
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=PYTHONUNBUFFERED=1

# Give the desktop a few seconds to finish painting before we steal the screen.
# Without this, fullscreen sometimes loses the race against the panel/taskbar.
ExecStartPre=/bin/sleep 8

ExecStart=/usr/bin/python3 /home/pi/bestTrack.py

# Always come back if it dies
Restart=always
RestartSec=3s

# Log to journald (view with: journalctl -u besttrack -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=besttrack

[Install]
WantedBy=graphical.target
