# Force LF line endings on all text files, regardless of OS that commits.
# This prevents CRLF from breaking shell scripts and systemd units on Linux.
* text=auto eol=lf

# Be explicit for the file types we ship
*.py       text eol=lf
*.sh       text eol=lf
*.service  text eol=lf
*.desktop  text eol=lf
.gitattributes text eol=lf
